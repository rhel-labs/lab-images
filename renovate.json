{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^registry/Containerfile$"],
      "matchStrings": ["ARG DISTRIBUTION_VERSION=(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "distribution/distribution",
      "datasourceTemplate": "github-releases"
    }
  ]
}
