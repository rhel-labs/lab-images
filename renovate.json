{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "hostRules": [
    {
      "matchHost": "registry.redhat.io",
      "username": "{{ secrets.RHT_REG_SVCUSER }}",
      "password": "{{ secrets.RHT_REG_SVCPASS }}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "registry.redhat.io/rhel9/**",
        "registry.redhat.io/rhel10/**",
        "registry.access.redhat.com/rhel",
        "registry.access.redhat.com/rhel-atomic",
        "registry.access.redhat.com/rhel-init",
        "registry.access.redhat.com/rhel-minimal",
        "registry.access.redhat.com/rhceph/**",
        "registry.access.redhat.com/rhgs3/**",
        "registry.access.redhat.com/rhel7**",
        "registry.access.redhat.com/rhel8/**",
        "registry.access.redhat.com/rhel9/**",
        "registry.access.redhat.com/rhscl/**",
        "registry.access.redhat.com/ubi*{,/}**",
        "redhat/**"
      ],
      "versioning": "redhat"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)registry/Containerfile$"],
      "matchStrings": ["ARG DISTRIBUTION_VERSION=(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "distribution/distribution",
      "datasourceTemplate": "github-releases"
    }
  ]
}
